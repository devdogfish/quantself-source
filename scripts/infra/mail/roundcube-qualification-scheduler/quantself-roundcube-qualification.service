[Unit]
Description=Qualify reviewed Roundcube security releases in disposable Docker
Wants=network-online.target
After=network-online.target docker.service
OnFailure=quantself-roundcube-qualification-failure.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/quantself-roundcube-qualification/checkout
RuntimeDirectory=quantself-roundcube-qualification
RuntimeDirectoryMode=0700
Environment=TMPDIR=/run/quantself-roundcube-qualification
Environment=DOCKER_HOST=unix:///run/docker.sock
Environment=DOCKER_CONFIG=/etc/quantself-roundcube-qualification/docker
Environment=ROUNDCUBE_FIXTURE_DOCKER_CONTEXT=default
ExecStart=/usr/bin/python3 -EBs /opt/quantself-roundcube-qualification/checkout/scripts/infra/mail/roundcube-qualification-scheduler/run-qualification.py
TimeoutStartSec=5min
TimeoutStopSec=30s
KillMode=mixed
# Container workers read synthetic bind-mounted files beneath the private runtime directory.
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quantself-roundcube-qualification
