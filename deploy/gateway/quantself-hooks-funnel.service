[Unit]
Description=Quantself Funnel webhook relay on Gate
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=notify
DynamicUser=yes
EnvironmentFile=/etc/quantself-hooks/funnel.env
StateDirectory=quantself-hooks-funnel
StateDirectoryMode=0700
Environment=XDG_CONFIG_HOME=/var/lib/quantself-hooks-funnel
Environment=XDG_DATA_HOME=/var/lib/quantself-hooks-funnel
ExecStartPre=/usr/local/bin/caddy validate --config /etc/quantself-hooks/Gate.Funnel.Caddyfile --adapter caddyfile
ExecStart=/usr/local/bin/caddy run --config /etc/quantself-hooks/Gate.Funnel.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
