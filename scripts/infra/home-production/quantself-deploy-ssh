#!/usr/bin/env bash
# Install as a root-owned sshd ForceCommand for the dedicated deploy account.
set -euo pipefail
set +x
unset github_token
request="${SSH_ORIGINAL_COMMAND:-}"
if [[ "$request" != preflight && ! "$request" =~ ^deploy\ [0-9a-f]{40}\ [1-9][0-9]{0,19}\ [1-9][0-9]{0,9}$ ]]; then
  echo "Unsupported Quantself CI command." >&2
  exit 1
fi
# Read to EOF and reject a NUL, oversized input, or a stalled sender.
read_status=0
IFS= read -r -d '' -n 4096 -t 10 github_token || read_status=$?
if [[ "$read_status" != 1 ]]; then
  echo "Invalid deployment credential." >&2
  exit 1
fi
if [[ "$request" == preflight ]]; then
  if [[ -n "$github_token" ]]; then
    echo "Unexpected preflight input." >&2
    exit 1
  fi
else
  if [[ "$github_token" != *$'\n' ]]; then
    echo "Invalid deployment credential." >&2
    exit 1
  fi
  github_token="${github_token%$'\n'}"
  if [[ ! "$github_token" =~ ^ghs_[A-Za-z0-9_.-]+$ ]]; then
    echo "Invalid deployment credential." >&2
    exit 1
  fi
fi
# The dispatcher sends OK only after the operation completes successfully.
{
  printf '%s\n' "$request"
  if [[ "$request" != preflight ]]; then
    printf '%s\n' "$github_token"
  fi
} |
  socat -t 2400 - UNIX-CONNECT:/run/quantself-deploy.sock |
  awk '{ if ($0 == "QUANTSELF_DEPLOY_OK") success=1; else { print; fflush(); } } END { exit !success }'
