[Unit]
Description=Keep storage guest network boundary
DefaultDependencies=no
Wants=network-pre.target
After=local-fs.target
Before=network-pre.target docker.service tailscaled.service ssh.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/apply-keep-storage-firewall
ExecReload=/usr/local/sbin/apply-keep-storage-firewall
# Deliberately no ExecStop: stopping this unit must not open access.

[Install]
WantedBy=multi-user.target
