# Owner fills these on quantself in a private root-owned mode-0600 .env file.
# Never paste the completed file into chat, logs, Git, or an issue.
# Local immutable sha256 image ID, verified after docker load:
QUANTSELF_IMAGE=
QUANTSELF_OWNER_EMAIL=
POSTGRES_PASSWORD=
# Same password as above, URL-encoded. Host is the Docker service "postgres".
DATABASE_URL=
QUANTSELF_OPENCLOUD_SPACE_ID=
QUANTSELF_OPENCLOUD_USERNAME=
QUANTSELF_OPENCLOUD_TOKEN=
QUANTSELF_ORIGINALS_WRITE_PAUSED=0
