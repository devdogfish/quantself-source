{
	admin off
	auto_https off
	grace_period 0
}

:3000 {
	encode zstd gzip

	@internal path /api/internal /api/internal/*
	handle @internal {
		respond 404
	}

	@api path /api /api/* /llms.txt
	handle @api {
		reverse_proxy api:3001 {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto https
		}
	}
}
