    {
      "id": "040b87b7-5793-4ab7-862e-83be68c5ad81",
      "name": "Check intake response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -120
      ],
      "parameters": {
        "jsCode": "function compactImportResponse(response) {\n  const statusCode = Number.isInteger(response?.statusCode) ? response.statusCode : null, body = response?.body;\n  return {\n    statusCode,\n    body: typeof body === \"object\" && body !== null ? {\n      imported: body.imported ?? null,\n      duplicates: body.duplicates ?? null,\n      idempotencyConflict: body.message === \"Idempotency-Key was already used with different input.\"\n    } : {}\n  };\n}\n\nfunction isRetryableImport(response) {\n  const { statusCode, body } = response;\n  return statusCode === null || statusCode === 409 && !body.idempotencyConflict || statusCode >= 500 && statusCode <= 599;\n}\n\nfunction readPilotImport(response) {\n  const compact = compactImportResponse(response), { applicationId, revision } = response.body ?? {};\n  if (compact.statusCode === 200 && /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/.test(applicationId) && revision === 0)\n    return { ...compact, applicationId, revision };\n  return compact;\n}\nconst response = readPilotImport($input.first().json);\nconst request = $('Prepare held intake').first().json;\nreturn [{ json: { ...request, response, retry: isRetryableImport(response) } }];"
      }
    },
    {
      "id": "a00e94a2-1114-4d17-831f-bd1aa565ec97",
