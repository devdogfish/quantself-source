{
  "name": "@quantself/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "start:production": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir dist --target bun --external sharp",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1169.0",
    "@hono/zod-openapi": "1.5.1",
    "@quantself/auth": "workspace:*",
    "@quantself/budgeting": "workspace:*",
    "@quantself/db": "workspace:*",
    "@scalar/api-reference": "1.63.0",
    "@scalar/hono-api-reference": "0.11.11",
    "@scalar/openapi-to-markdown": "0.5.36",
    "hono": "4.12.32",
    "sharp": "0.34.5",
    "web-push": "^3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@readme/openapi-parser": "6.3.0",
    "@types/bun": "^1",
    "@types/web-push": "^3.6.4",
    "openapi-types": "12.1.3",
    "typescript": "^5"
  }
}
