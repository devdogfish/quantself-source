[Unit]
Description=Handle one Jobs mailbox request for Sam
PartOf=quantself-jobs-mail.socket

[Service]
Type=exec
User=quantself-jobs-mail
StateDirectory=quantself-jobs-mail
StateDirectoryMode=0700
LoadCredentialEncrypted=imap:/etc/quantself-jobs-mail/imap.cred
# Optional credential from /etc/credstore.encrypted. Reading remains available without SES.
LoadCredentialEncrypted=qs196-jobs-ses
EnvironmentFile=/etc/hermes/.env
ExecStart=/usr/bin/python3 -IB /usr/local/libexec/quantself-jobs-mail/jobs_mail_service.py
StandardInput=socket
StandardOutput=socket
StandardError=null
RuntimeMaxSec=65s
UMask=0077
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
