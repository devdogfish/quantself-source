POSTGRES_USER=quantself
POSTGRES_PASSWORD=
POSTGRES_DB=quantself
DATABASE_URL=postgresql://quantself:REPLACE_WITH_PASSWORD@postgres:5432/quantself
BETTER_AUTH_SECRET=
QUANTSELF_PUBLIC_ORIGIN=
# Trusted Keep ingress injects this proof for approved devices.
QUANTSELF_OWNER_INGRESS_TOKEN=
QUANTSELF_PRODUCTION_URL=
QUANTSELF_INSTANCE_NAME="Quantself Prod 1.0"
QUANTSELF_OWNER_EMAIL=production@quantself.valid
API_PORT=3001
QUANTSELF_API_INTERNAL_URL=http://api:3001
INVENTORY_UPLOAD_DIR=/app/storage/inventory-images
INVENTORY_AUDIO_UPLOAD_DIR=/app/storage/inventory-audio
INVENTORY_ASSET_UPLOAD_DIR=/app/storage/inventory-assets
GIRKE_API_TOKEN=
GIRKE_API_BASE_URL=
INVENTORY_PREPROCESSING_WORKER_SECRET=
INVENTORY_PREPROCESSING_WORKER_BASE_URL=http://api:3001
INVENTORY_ENRICHMENT_WORKER_SECRET=
INVENTORY_ENRICHMENT_WORKER_BASE_URL=http://api:3001
JOBS_WORKER_SECRET=
JOBS_RUNNER_SECRET=
# Private host directory with engineering.md, web.md and admin.md. Mounted read-only in the API.
QUANTSELF_JOBS_RESUME_TEMPLATES_SOURCE=

# Server-only GitHub App access for durable To-Dos. Distinct, same-org private repos.
QUANTSELF_TODO_REPOSITORY=
QUANTSELF_TODO_TEST_REPOSITORY=
# Private organization Me Project; sync failure is separate from saving a task.
QUANTSELF_TODO_PROJECT_NUMBER=
QUANTSELF_GITHUB_APP_ID=
QUANTSELF_GITHUB_INSTALLATION_ID=
# Quoted multiline PEM signing key; never use NEXT_PUBLIC_ variables for these values.
QUANTSELF_GITHUB_PRIVATE_KEY=
# Same secret configured on the GitHub App webhook; API-only HMAC verification.
QUANTSELF_GITHUB_WEBHOOK_SECRET=

# Untouched To-Do audio; metadata keeps root-independent relative keys.
QUANTSELF_TODO_CAPTURE_ROOT=/app/storage/todo-captures
# Named volume, or absolute host directory when relocating to another disk.
QUANTSELF_TODO_CAPTURE_VOLUME=quantself_todo_captures

# Private Jarvis. Keep the provider key server-side.
QUANTSELF_ELEVENLABS_AGENT_ID=
QUANTSELF_ELEVENLABS_API_KEY=
# Optional HTTPS API tunnel for local development; defaults to QUANTSELF_PUBLIC_ORIGIN.
QUANTSELF_JARVIS_TOOL_ORIGIN=

# Native root dev: optional local upload/recording directory and auth secret.
# QUANTSELF_DEV_STORAGE_ROOT=/absolute/path/to/storage
# QUANTSELF_DEV_AUTH_SECRET=local-development-secret
# Dedicated agent overrides QUANTSELF_ELEVENLABS_AGENT_ID only in native development.
# QUANTSELF_DEV_ELEVENLABS_AGENT_ID=agent_development
# Stable named tunnel (optional; provision dedicated DNS/ingress separately).
# QUANTSELF_DEV_TUNNEL_ORIGIN=https://quantself-local.example.com
# QUANTSELF_DEV_TUNNEL_CONFIG=/absolute/path/to/development-tunnel.yml
# Set to 0 only when explicitly developing without Jarvis.
# QUANTSELF_DEV_JARVIS=0

# Opt in to update the GitHub App webhook to the current native development tunnel.
# QUANTSELF_DEV_GITHUB_WEBHOOK=1
# Optional browser-accessible Photon /api/ endpoint for location suggestions.
# Default: https://photon.komoot.io/api/ (reasonable owner-scale usage; no uptime guarantee).
# NEXT_PUBLIC_PHOTON_URL=https://your-photon-host.example/api/

# Map stable Agent Client IDs to their private Bot HQ URLs on the API server.
# QUANTSELF_BOT_HQ_AGENT_LINKS='{"agent-client-id":"https://bot-hq.your-tailnet.ts.net/agents/example"}'
# QUANTSELF_TODO_DELEGATION_STALE_MINUTES=1440

# Stable Web Push VAPID keys (generate once; keep private key secret).
QUANTSELF_PUSH_PUBLIC_KEY=
QUANTSELF_PUSH_PRIVATE_KEY=
QUANTSELF_PUSH_SUBJECT=
# Optional private telephone Jarvis; enabled only after provider setup.
QUANTSELF_PHONE_ENABLED=
QUANTSELF_PHONE_PUBLIC_URL=
# Dedicated API client key, limited to todos:read and todos:write.
QUANTSELF_PHONE_API_KEY=
QUANTSELF_ELEVENLABS_PHONE_AGENT_ID=
QUANTSELF_TWILIO_ACCOUNT_SID=
QUANTSELF_TWILIO_AUTH_TOKEN=
QUANTSELF_TWILIO_PHONE_NUMBER=
QUANTSELF_PHONE_OWNER_NUMBER=
QUANTSELF_PHONE_PIN_HASH=

# Separate private Habit App; server only. Never reuse task credentials.
QUANTSELF_HABITS_REPOSITORY=
QUANTSELF_HABITS_GITHUB_APP_ID=
QUANTSELF_HABITS_GITHUB_INSTALLATION_ID=
QUANTSELF_HABITS_GITHUB_PRIVATE_KEY=

# Legacy analytics rollback and historical reimport.
QUANTSELF_WEBSITE_ANALYTICS_TOKEN=
QUANTSELF_UMAMI_URL=
QUANTSELF_UMAMI_WEBSITE_ID=
# Use the dedicated read-only Umami role.
QUANTSELF_UMAMI_READ_DATABASE_URL=

# Native portfolio ingest and tracked links. Four distinct scoped API-only keys.
QUANTSELF_WEBSITE_ANALYTICS_INGEST_TOKEN=
QUANTSELF_TRACKED_LINKS_READ_TOKEN=
QUANTSELF_TRACKED_LINKS_APPLICATION_TOKEN=
QUANTSELF_TRACKED_LINKS_SHARE_TOKEN=

# Keep API only. Use SES send-only credentials dedicated to the booking sender.
QUANTSELF_MEETINGS_FROM=
QUANTSELF_MEETINGS_OWNER_EMAIL=
QUANTSELF_MEETINGS_JITSI_ORIGIN=
QUANTSELF_MEETINGS_PORTFOLIO_ORIGIN=
QUANTSELF_MEETINGS_SES_REGION=ca-central-1
QUANTSELF_MEETINGS_TIME_ZONE=America/Halifax
QUANTSELF_MEETINGS_AWS_ACCESS_KEY_ID=
QUANTSELF_MEETINGS_AWS_SECRET_ACCESS_KEY=
QUANTSELF_MEETINGS_AWS_SESSION_TOKEN=
