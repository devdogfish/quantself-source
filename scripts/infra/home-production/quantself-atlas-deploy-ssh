#!/usr/bin/env bash
# Install as the forced command for the dedicated deploy-atlas account.
set -euo pipefail
set +x
unset token
request=${SSH_ORIGINAL_COMMAND:-}
if [[ ! "$request" =~ ^promote-atlas\ [0-9a-f]{40}\ [1-9][0-9]{0,19}\ [1-9][0-9]{0,9}$ ]]; then
  echo "Unsupported Atlas deploy command." >&2
  exit 1
fi
read_status=0
IFS= read -r -d '' -n 4096 -t 10 token || read_status=$?
if [[ "$read_status" != 1 || "$token" != *$'\n' ]]; then
  echo "Invalid Atlas deploy credential." >&2
  exit 1
fi
token=${token%$'\n'}
if [[ ! "$token" =~ ^ghs_[A-Za-z0-9_.-]+$ ]]; then
  echo "Invalid Atlas deploy credential." >&2
  exit 1
fi
reply="$(
  printf '%s\n%s\n' "$request" "$token" |
    /usr/bin/socat -t 2500 - UNIX-CONNECT:/run/quantself-atlas-deploy.sock
)"
if [[ "$reply" != QUANTSELF_DEPLOY_OK ]]; then
  echo "Atlas deploy rejected or unconfirmed. Inspect the Keep deployment journal." >&2
  exit 1
fi
printf '%s\n' "$reply"
