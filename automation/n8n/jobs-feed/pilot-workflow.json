  "nodes": [
    {
      "id": "13274d5c-a385-4e9f-8c8e-79b8e0180cd0",
      "name": "Manual trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "66fb901c-526f-499f-8520-700b509048f4",
      "name": "Pilot configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const config = {\"gatewayOrigin\":\"\",\"permitId\":\"\",\"sourceIdentity\":\"\"};\nconst { gatewayOrigin, permitId, sourceIdentity } = config;\nif (!/^(?:https:\\/\\/[a-z\\d-]+(?:\\.[a-z\\d-]+)+(?::\\d{1,5})?|http:\\/\\/127\\.0\\.0\\.1:\\d{1,5})$/i.test(gatewayOrigin) ||\n    !/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/i.test(permitId) ||\n    !/^greenhouse:global:[a-z0-9_-]{1,120}:[1-9][0-9]{0,15}$/.test(sourceIdentity)) {\n  throw new Error('Configure the inactive pilot with its private gateway, exact permit, and one Greenhouse posting.');\n}\nreturn [{ json: { ...config, body: { sourceIdentity } } }];"
      }
    },
    {
      "id": "e0415e14-145b-4895-80bc-f62dd6a9e31e",
      "name": "Screen permitted posting",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Pilot configuration').first().json.gatewayOrigin + '/screen' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Jobs-Pilot-Permit",
              "value": "={{ $('Pilot configuration').first().json.permitId }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 55000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "4fddf4ad-d60c-41a6-80c0-7f8b88e3f430",
      "name": "Prepare held intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst { permitId, sourceIdentity } = $('Pilot configuration').first().json;\nconst application = response.body?.application;\nconst kept = response.statusCode === 200 && response.body?.outcome === 'keep' && application?.sourceIdentity === sourceIdentity;\nreturn [{ json: { kept, screenStatus: response.statusCode ?? null,\n  screening: kept ? 'keep' : response.statusCode === 200 && response.body?.outcome === 'no_import' ? 'no_import' : 'blocked',\n  ...(kept && { idempotencyKey: 'n8n-jobs-pilot-' + permitId, body: { applications: [application] } }),\n} }];"
      }
    },
    {
      "id": "d2792b31-7149-42e6-805c-eb52f305c451",
      "name": "Import approved keep?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "kept",
              "leftValue": "={{ $json.kept === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "28e20564-1d0d-4e09-8e3d-cfbaa192293e",
