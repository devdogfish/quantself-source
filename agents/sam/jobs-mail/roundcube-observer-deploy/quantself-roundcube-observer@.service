[Unit]
Description=Observe one exact Jobs Message-ID for the private Quantself API
PartOf=quantself-roundcube-observer.socket

[Service]
Type=exec
DynamicUser=yes
EnvironmentFile=/etc/quantself-roundcube-observer/observer.env
LoadCredentialEncrypted=imap:/etc/quantself-roundcube-observer/imap.cred
ExecStart=/usr/bin/python3 -IB /usr/local/libexec/quantself-roundcube-observer/jobs_roundcube_observer.py
StandardInput=socket
StandardOutput=socket
StandardError=null
TimeoutStartSec=5s
RuntimeMaxSec=5s
TimeoutStopSec=1s
UMask=0077
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=64M
TasksMax=8
LimitCORE=0
