{
	admin off
	auto_https off
}

https://quantself-restore.test:18443 {
	tls /run/restore/tls/server.pem /run/restore/tls/server.key

	@internal path /api/internal /api/internal/*
	handle @internal {
		respond 404
	}

	@api path /api /api/* /llms.txt
	handle @api {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy app:3000
	}
}
